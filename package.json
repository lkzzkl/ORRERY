{
  "name": "orrery",
  "version": "1.0.0",
  "private": true,
  "description": "ORRERY / 星图 — 无胜负的参数化星系编排玩具，导出可提交进仓库的矢量海报",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
